{
	"apps": [
		"apps/fsapp.app",
		"apps/marketplace.app",
		"apps/ashell.app",
		"apps/v86-terminal.app"
	],
	"libs": [
		"/AnuraOS/apps/libfileview.lib",
		"/AnuraOS/apps/libfilepicker.lib",
		"/AnuraOS/apps/libstore.lib",
		"/AnuraOS/apps/libpersist.lib",
		"/AnuraOS/apps/libhterm.lib"
	],
	"bin": [
		"/AnuraOS/bin/chimerix.ajs",
		"/AnuraOS/bin/x86-run.ajs",
		"/AnuraOS/bin/vista.ajs",
		"/AnuraOS/bin/anuractrl.ajs"
	],
	"defaultsettings": {
		"use-sw-cache": false,
		"applist": [
			"anura.browser",
			"anura.settings",
			"anura.fsapp"
		],
		"clampWindows": true,
		"launcher-keybind": true,
		"wisp-url": "wss://wisp.mercurywork.shop/"
	},
	"x86": {
		"alpine": {
			"bzimage": "x86images/alpine-boot/vmlinuz-virt",
			"initrd": "x86images/alpine-boot/initramfs-virt",
			"rootfs": [
				"x86images/alpine-rootfs/aa",
				"x86images/alpine-rootfs/ab",
				"x86images/alpine-rootfs/ac",
				"x86images/alpine-rootfs/ad",
				"x86images/alpine-rootfs/ae",
				"x86images/alpine-rootfs/af"
			],
			"rootfsCompression": "gzip"
		}
	}
}
